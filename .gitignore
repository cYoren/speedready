build-dir/
.flatpak-builder/
__pycache__/
.venv/
.wheels/

# never commit the release signing key or its passwords (F-Droid reproducible builds)
keystore.properties
*.keystore
*.jks

# gradle build output and caches (126 of these were committed by accident)
android/.gradle/
android/build/
android/app/build/

# per-machine SDK path; a committed copy points the build at a directory that only exists
# on the machine that wrote it, which breaks F-Droid's buildserver
local.properties
android/local.properties
