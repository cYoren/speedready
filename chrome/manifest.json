{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Speedready",
  "description": "__MSG_extDescription__",
  "version": "0.0.0",
  "default_locale": "en",
  "homepage_url": "https://speedready.vercel.app/",
  "action": {"default_popup": "popup.html", "default_title": "__MSG_readPage__"},
  "background": {"service_worker": "background.js"},
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "commands": {
    "read-page": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "__MSG_readPage__"}
  },
  "web_accessible_resources": [{"resources": ["app/*"], "matches": ["<all_urls>"]}],
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
